# Copy to .env

# From @BotFather (/newbot). Leave empty to run the board without the bot.
BOT_TOKEN=

# Your Telegram user id. You are the admin: you approve who joins.
# Don't know it? Start the bot without this set and send /id.
ADMIN_USER_ID=

# Public HTTPS address of this server. Telegram only opens Mini Apps over HTTPS.
# Local dev: run a tunnel (e.g. `cloudflared tunnel --url http://localhost:8787`) and paste its URL.
PUBLIC_URL=

PORT=8787

# Tracking store: a MongoDB connection string. Atlas: mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/abro
# Local dev: mongodb://127.0.0.1:27017/abro_dev. Required; Abro won't start without it.
DATABASE_URL=

# Apleo's API, where job leads are posted. The key must match ABRO_API_KEY on Apleo.
APLEO_API_URL=
APLEO_API_KEY=

# Time zone for new members and for the group recap / session reminders.
# Each person can change their own with /tz (e.g. /tz Asia/Shanghai).
DEFAULT_TZ=Africa/Addis_Ababa

# Local times for the "clock in" nudge (DM) and the evening recap (group).
NUDGE_AT=10:00
RECAP_AT=22:00

# Local testing only: open http://localhost:8787 in a normal browser as this member id.
# Only works from localhost. Leave empty in production.
DEV_USER_ID=

# Feed (daily picks, project ideas, weekly "what to improve" notes).
# Gemini is tried first; OpenRouter is the fallback. Either one alone works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
# Any OpenRouter model id. Ones ending in ":free" cost nothing but are rate-limited.
OPENROUTER_MODEL=google/gemini-2.5-flash
# When the daily feed is built and posted (DEFAULT_TZ). Weekly notes come on Sundays.
FEED_AT=07:30

# Hosting on a free tier that sleeps (e.g. Render): use webhooks instead of polling,
# and have a free scheduler (e.g. cron-job.org) call GET /tick?key=CRON_KEY every 10 minutes.
BOT_MODE=polling
# Random string; Telegram echoes it back on every webhook call.
WEBHOOK_SECRET=
# Random string guarding /tick.
CRON_KEY=

# Encrypts each person's portfolio API key in the database. Any long random string.
# Changing it later means everyone re-enters their portfolio key.
ENCRYPTION_KEY=

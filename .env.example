# Copy to .env

# From @BotFather (/newbot). Leave empty to run the board without the bot.
BOT_TOKEN=

# Your Telegram user id. You are the admin: you approve who joins.
# Don't know it? Start the bot without this set and send /id.
ADMIN_USER_ID=

# Public HTTPS address of this server. Telegram only opens Mini Apps over HTTPS.
# Local dev: run a tunnel (e.g. `cloudflared tunnel --url http://localhost:8787`) and paste its URL.
PUBLIC_URL=

PORT=8787

# Tracking store: your Neon connection string (postgres://...neon.tech/...?sslmode=require).
# Leave empty for local dev; a PGlite folder in ./data is used instead.
DATABASE_URL=

# Apleo's API, where job leads are posted. The key must match ABRO_API_KEY on Apleo.
APLEO_API_URL=
APLEO_API_KEY=

# Time zone for new members and for the group recap / session reminders.
# Each person can change their own with /tz (e.g. /tz Asia/Shanghai).
DEFAULT_TZ=Africa/Addis_Ababa

# Local times for the "clock in" nudge (DM) and the evening recap (group).
NUDGE_AT=10:00
RECAP_AT=22:00

# Local testing only: open http://localhost:8787 in a normal browser as this member id.
# Only works from localhost. Leave empty in production.
DEV_USER_ID=
